generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Board {
  id          String     @id @default(cuid())
  name        String
  description String
  link        String
  tags        String[]   // optional at app level
  categories  Category[] @relation("BoardCategories")

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Category {
  id          String     @id
  name        String
  description String
  boards      Board[]    @relation("BoardCategories")
}
